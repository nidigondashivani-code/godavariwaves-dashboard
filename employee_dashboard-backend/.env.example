# ==============================================================================
# Godavari Wave Technologies Pvt. Ltd. — Shared EMS Backend Configuration
# Copy this file to `.env` locally and fill in your private Aiven MySQL values.
# NEVER commit `.env` or CA certificate files (`*.pem`) to GitHub.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Cloud MySQL 8 Configuration (Aiven Free MySQL: https://aiven.io/free-mysql-database)
DB_HOST=
DB_PORT=
DB_NAME=godavari_waves
DB_USER=
DB_PASSWORD=
DB_DIALECT=mysql
DB_SSL=true
DB_CA_CERT_PATH=certs/ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Authentication Secrets (use strong random strings shared by Admin & Employee backend)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# File Uploads Directory
UPLOAD_DIR=uploads

# Office Policy Defaults
OFFICE_START_TIME=09:30
GRACE_PERIOD_MINUTES=15
LATE_THRESHOLD_TIME=09:45
AUTO_ABSENT_TIME=11:00
OFFICE_END_TIME=18:30
